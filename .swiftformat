# Swift 버전
--swiftversion 5.9

# 들여쓰기
--indent 4
--indentcase false
--ifdef no-indent

# 줄바꿈
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions after-first

# 공백
--trimwhitespace always
--stripunusedargs closure-only

# import 정렬
--importgrouping alpha

# self 사용
--self init-only

# 후행 클로저
--trailingclosures
# UIKit 멀티 클로저 API는 trailing closure 변환 제외 (가독성 저하 방지)
--nevertrailing animate,asyncAfter

# 쉼표
--commas always

# 비활성화 규칙
# redundantReturn: 단일 표현식에서 명시적 return 허용 (.swiftlint.yml의 direct_return과 일치)
--disable redundantReturn
# redundantSelf: 명시적 self. 사용 허용 (.swiftlint.yml의 redundant_self와 일치)
--disable redundantSelf
--disable wrapMultilineStatementBraces

# 제외 경로
--exclude Tuist,.build,Tools,Configs,**/Derived,**/Generated
