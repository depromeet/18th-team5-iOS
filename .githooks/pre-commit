#!/bin/bash

# SwiftFormat pre-commit hook
# 커밋 시 변경된 Swift 파일에 대해 자동으로 포맷팅을 적용합니다.

if ! command -v swiftformat >/dev/null 2>&1; then
    echo "warning: SwiftFormat이 설치되어 있지 않습니다. 'brew install swiftformat'으로 설치해주세요."
    exit 0
fi

# 스테이징된 Swift 파일만 포맷팅
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$')

if [ -z "$STAGED_SWIFT_FILES" ]; then
    exit 0
fi

echo "$STAGED_SWIFT_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        swiftformat "$file" --quiet
        git add "$file"
    fi
done
